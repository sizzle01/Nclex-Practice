# Public entry point of the test VM (compose.vm.yml). SITE_HOST comes from .env: a free DuckDNS
# name pointed at the VM's IP. Caddy gets a Let's Encrypt certificate for every name below.
{$SITE_HOST} {
	encode gzip

	# The frontend serves the pages and forwards /api to the API (nclex-fe next.config.ts), exactly
	# as on the full local stack, so Caddy only needs one upstream. flush_interval -1 keeps
	# server-sent notifications (architecture.md, ADR-6) streaming instead of buffered.
	reverse_proxy web:3000 {
		flush_interval -1
	}
}

# Earlier addresses (comma-separated in REDIRECT_HOSTS) keep working: links already shared,
# and emails already sent, land on the same page at the current address.
{$REDIRECT_HOSTS} {
	redir https://{$SITE_HOST}{uri} permanent
}
