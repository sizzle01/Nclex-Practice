# Settings for the test VM (compose.vm.yml). setup.sh copies this file to .env on the VM and fills
# in the generated secrets. Never commit the real .env: it holds passwords and keys.

# The public host name: a free DuckDNS name (duckdns.org) whose IP is set to the VM's.
SITE_HOST=fatimah-test.duckdns.org
# Earlier names, comma-separated, that redirect to SITE_HOST. Must not be empty or include SITE_HOST.
# sslip.io turns an IP into a name (129-146-180-15.sslip.io resolves to 129.146.180.15).
REDIRECT_HOSTS=129-146-180-15.sslip.io

# Generated by setup.sh (random hex, so they are safe inside connection strings).
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
MEDIA_SIGNING_KEY=

# Email through Brevo (Brevo dashboard → SMTP & API). EMAIL_FROM must be a sender verified in Brevo.
EMAIL_FROM="NCLEX Practice <talktoaliyu@gmail.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=c34b01001@smtp-brevo.com
# The Brevo SMTP key. setup.sh asks for it; it is never stored in the repository.
SMTP_PASSWORD=
