        "unit": "mL/hr",
        "decimals": 0,
        "inputLabel": "Infusion rate"
      },
      "key": {
        "value": 700,
        "rounding": "exact"
      },
      "rationale": {
        "correct": "Total = 4 × 70 × 40 = 11,200 mL in 24 hours. Half (5,600 mL) in the first 8 hours = 5,600 ÷ 8 = 700 mL/hr.",
        "perOption": {},
        "references": [
          "Medical-surgical nursing texts (e.g. Lewis; Ignatavicius)",
          "DRAFT: original question written with AI assistance; an RN or nurse educator must check it before candidates rely on it."
